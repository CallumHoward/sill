{
  "name": "@callumhoward/sill",
  "version": "0.1.0",
  "description": "Schema validation for config files: respects $schema and falls back to the SchemaStore catalog. JSON, JSONC, JSON5, YAML, TOML.",
  "keywords": [
    "config",
    "json-schema",
    "json5",
    "jsonc",
    "lint",
    "schemastore",
    "toml",
    "validation",
    "yaml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CallumHoward/sill.git"
  },
  "bin": {
    "sill": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "lint": "oxlint --type-aware",
    "lint:ci": "oxlint --type-aware --format=github",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "tsc --noEmit",
    "fallow": "fallow --fail-on-issues",
    "prepublishOnly": "pnpm build",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@humanwhocodes/momoa": "^3.3.13",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "ignore": "^7.0.10",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "toml-eslint-parser": "^1.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/picomatch": "^4.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@wcmj/config-base": "^0.1.3",
    "fallow": "^3.30.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "stylelint": "^17.15.0",
    "tsdown": "^0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.9.0"
}
